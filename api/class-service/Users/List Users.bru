meta {
  name: List Users
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/users?limit=50&offset=0
  body: none
  auth: none
}

params:query {
  limit: 50
  offset: 0
  ~role: student
  ~orgId: {{orgId}}
}

docs {
  Lists users with optional filters by `role` (`student`, `teacher`, `admin`) or `orgId`.
}
