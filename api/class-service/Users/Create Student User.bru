meta {
  name: Create Student User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

body:json {
  {
    "displayName": "Nguyễn Văn An",
    "role": "student",
    "email": "an.nguyen@example.edu.vn",
    "orgSourcedId": "{{orgId}}"
  }
}

vars:post-response {
  userId: res.body.sourcedId
}

docs {
  Creates a student user.
  The minted `sourcedId` is the platform's anonymous `candidateId`.
  Saves the returned `sourcedId` into variable `userId`.
}
