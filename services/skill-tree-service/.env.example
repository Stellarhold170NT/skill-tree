# SkillTree Harness (M4) — copy thành .env nếu cần override (compose tự đọc)

# Host được phép truy cập Web UI :8104 (phân tách bằng dấu cách).
# Thêm máy dev LAN: EXTRA_TRUSTED_HOSTS=localhost:8104 127.0.0.1:8104 192.168.1.50:8104
EXTRA_TRUSTED_HOSTS=localhost:8104 127.0.0.1:8104

# Điểm nối với hệ thống (được dùng khi viết plugin skilltree — xem plugins/skilltree/README.md):
# OPENCASE_URL=http://opencase-service:8101
# QUIZ_URL=http://quiz-service:8102
# COGNEE_MCP_URL=http://${DEV_HOST}:8021/mcp

# Gateway (M10) mà plugin skilltree-auth-ui dùng để gọi auth-service (M11):
# mặc định http://localhost:8000; trong compose platform-net → http://api-gateway:8000
# SKILLTREE_GATEWAY_URL=http://api-gateway:8000
