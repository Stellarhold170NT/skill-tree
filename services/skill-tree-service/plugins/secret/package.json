{
  "name": "secret",
  "version": "1.0.0",
  "description": "SkillTree Secrets manager: a Settings tab over the local credential vault - write-only values, list names, delete",
  "type": "module",
  "main": "lib/index.js",
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "keywords": ["dsh-plugin", "secrets", "credentials"],
  "license": "MIT"
}