# SkillTree .env (template) — copy sang .env va dien API key
# LLM — gateway OpenAI-compatible (NetMind/Viettel), da test 200 OK voi GLM-5.3-Flash
LLM_PROVIDER=openai
LLM_ENDPOINT=https://netmind.viettel.vn/gateway/v1
LLM_API_KEY=SK-HAY-DIEN-API-KEY
LLM_MODEL=zai-org/GLM-5.3-Flash
LLM_RATE_LIMIT_ENABLED=true

# Embedding — local fastembed (gateway khong co /embeddings)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# State — ghim vao project (khong de roi vao site-packages)
SYSTEM_ROOT_DIRECTORY=/workspace/.cognee_system
DATA_ROOT_DIRECTORY=/workspace/.data_storage
