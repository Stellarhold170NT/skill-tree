# Copy to .env and adjust before `docker compose --env-file .env up -d`
# (defaults below work for local development)

OPENCASE_PORT=8101
QUIZ_PORT=8102
CLASS_PORT=8103
ANALYTICS_PORT=8104
LEARNER_PORT=8105
ASSIGNMENT_PORT=8106
DOCUMENT_PORT=8107
LATEXML_PORT=8110
RAG_PORT=8109
RENDER_TIMEOUT_S=900
MAX_UPLOAD_MB=100
GATEWAY_PORT=8000
GATEWAY_RATE_LIMIT=120
AUTH_PORT=8108
AUTH_TOKEN_TTL=3600
# Set a strong secret + admin bootstrap token in any shared environment
AUTH_SECRET=dev-secret-change-me
ADMIN_REGISTRATION_TOKEN=

OPENCASE_DB_PASSWORD=opencase_dev
QUIZ_DB_PASSWORD=quiz_dev
CLASS_DB_PASSWORD=class_dev
ANALYTICS_DB_PASSWORD=analytics_dev
LEARNER_DB_PASSWORD=learner_dev
ASSIGNMENT_DB_PASSWORD=assignment_dev
DOCUMENT_DB_PASSWORD=document_dev
AUTH_DB_PASSWORD=auth_dev

# Public base URI used when generating CASE identifiers (CFDocument/CFItem).
# In production, set this to the externally reachable URL, e.g.
# https://your-domain/case — existing identifiers are immutable once issued.
CASE_BASE_URI=http://localhost:8101/api/v1/case
