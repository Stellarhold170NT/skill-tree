# Cognee Server Deployment Configuration (Module M8 - Classroom Memory)
# Copy file này thành .env trong cùng thư mục trước khi chạy: cp .env.example .env

# --- Cổng dịch vụ ---
# Port MCP Streamable-HTTP expose ra máy host (theo hợp đồng skill-tree-service patch.yml)
COGNEE_MCP_PORT=8021
# Port REST API và Swagger UI (/docs)
COGNEE_API_PORT=8020

# --- Cấu hình LLM (Trích xuất thực thể, quan hệ đồ thị) ---
# Nhà cung cấp: openai, netmind, openrouter, ollama, anthropic, v.v.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-your-llm-api-key-here
# Nếu dùng endpoint tùy biến (ví dụ: NetMind, Ollama http://host.docker.internal:11434, LocalAI)
LLM_ENDPOINT=

# --- Cấu hình Embedding (Vector hóa các node và chunks) ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=sk-your-embedding-api-key-here
EMBEDDING_ENDPOINT=

# --- Cấu hình nội bộ Cognee ---
# Tắt Access Control để AI Agent nội bộ truy cập không cần auth phức tạp
ENABLE_BACKEND_ACCESS_CONTROL=false
# Bỏ qua connection test ban đầu để tránh timeout với reasoning LLM
COGNEE_SKIP_CONNECTION_TEST=true
